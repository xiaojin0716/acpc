+/// Five terminal cells, with eighth-cell precision so small usage changes stay visible.
+fn compact_usage(percent: f64) -> String {
+    const BLOCKS: [char; 9] = ['░', '▏', '▎', '▍', '▌', '▋', '▊', '▉', '█'];
+    const CELLS: usize = 5;
+    let percent = percent.clamp(0.0, 100.0);
+    let filled = (percent * (CELLS * 8) as f64 / 100.0).round() as usize;
+    let bar: String = (0..CELLS)
+        .map(|cell| BLOCKS[filled.saturating_sub(cell * 8).min(8)])
+        .collect();
+    format!("{percent:.0}% {bar}")
+}
