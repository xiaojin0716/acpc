From: Local acpc build <local@localhost>
Subject: [PATCH] acpc: show local branch and live session settings above usage

---
diff --git a/codex-rs/tui/src/chatwidget/status_surfaces.rs b/codex-rs/tui/src/chatwidget/status_surfaces.rs
--- a/codex-rs/tui/src/chatwidget/status_surfaces.rs
+++ b/codex-rs/tui/src/chatwidget/status_surfaces.rs
@@ -216,13 +216,25 @@
             }
         }
 
-        let line = status_line_from_segments(
-            segments,
+        let render = |items| status_line_from_segments(
+            items,
             self.local_settings.tui.status_line_use_colors,
             self.thread_id,
             self.status_line_pull_request_url(),
         );
-        self.set_status_line(line.map(Into::into));
+        // Keep both budgets visible even when the local checkout has a long path.
+        if crate::acpc::enabled()
+            && let Some(index) = segments.iter().position(|(item, _)| *item == StatusLineItem::ContextUsed)
+            && index > 0
+        {
+            let usage = segments.split_off(index);
+            let rows = render(segments).zip(render(usage)).map(|(session, usage)| {
+                crate::bottom_pane::footer_content::FooterContent::Rows([session, usage])
+            });
+            self.set_status_line(rows);
+        } else {
+            self.set_status_line(render(segments).map(Into::into));
+        }
     }
 
     /// Clears the terminal title Codex most recently wrote, if any.
@@ -609,14 +621,22 @@
         if self.status_line_branch_pending {
             return;
         }
-        let Some(runner) = self.workspace_command_runner.clone() else {
+        let runner = self.workspace_command_runner.clone();
+        let local = crate::acpc::enabled();
+        if !local && runner.is_none() {
             self.status_line_branch_lookup_complete = true;
             return;
-        };
+        }
         self.status_line_branch_pending = true;
         let tx = self.app_event_tx.clone();
         tokio::spawn(async move {
-            let branch = branch_summary::current_branch_name(runner.as_ref(), &cwd).await;
+            let branch = if local {
+                codex_git_utils::current_branch_name(&cwd).await
+            } else if let Some(runner) = runner {
+                branch_summary::current_branch_name(runner.as_ref(), &cwd).await
+            } else {
+                None
+            };
             tx.send(AppEvent::StatusLineBranchUpdated { cwd, branch });
         });
     }
@@ -724,6 +744,14 @@
     pub(super) fn status_line_value_for_item(&mut self, item: StatusLineItem) -> Option<String> {
         match item {
             StatusLineItem::ModelName => Some(self.model_display_name().to_string()),
+            StatusLineItem::ModelWithReasoning if crate::acpc::enabled() => {
+                let effort = self.current_collaboration_mode.reasoning_effort();
+                let effort = effort.as_ref().map_or("—", |value| value.as_str());
+                Some(format!("{} · effort {effort}", self.model_display_name()))
+            }
+            StatusLineItem::ApprovalMode if crate::acpc::enabled() => {
+                Some(format!("mode {}", self.acpc_current_mode().unwrap_or("—")))
+            }
             StatusLineItem::ModelWithReasoning => Some(self.model_with_reasoning_display_name()),
             StatusLineItem::Reasoning => Some(self.reasoning_display_name()),
             StatusLineItem::Profile => {
